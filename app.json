{
  "expo": {
    "name": "BlinkSy Food",
    "slug": "blinksy-food-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF1F3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blinksy.foodapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash.png",
        "backgroundColor": "#FF1F3A"
      },
      "package": "com.blinksy.foodapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/splash.png"
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
